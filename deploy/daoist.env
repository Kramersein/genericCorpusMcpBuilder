# A second server next to the default one: the Daoist texts from Kanripo, on port 8766.
#   docker compose --env-file deploy/daoist.env run --rm builder    download and build (about half an hour)
#   docker compose --env-file deploy/daoist.env up -d               serve http://127.0.0.1:8766/mcp
# The project name keeps its containers and volumes apart from the default server's.
#
# Behind nginx (sudo CORPUS_MCP_ROUTE=/daoist/mcp CORPUS_MCP_PORT=8766 sh deploy/enable-nginx-route.sh), the server
# must accept the public host name: put it in deploy/daoist.local.env (git ignores it) and pass both files:
#   echo 'CORPUS_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,nas.local,nas.local:*' > deploy/daoist.local.env
#   docker compose --env-file deploy/daoist.env --env-file deploy/daoist.local.env up -d
COMPOSE_PROJECT_NAME=corpus-daoist
CORPUS_MCP_SOURCE=kanripo
CORPUS_MCP_DATA_DIR=./data-kanripo-daoist
CORPUS_MCP_PORT=8766
